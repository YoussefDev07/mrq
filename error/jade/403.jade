doctype
html(lang="ar", type="text/html")
  - const errorCODE = 403;
  - const errorMESSAGE = "ليس لديك صلاحيات";
  head
    //- meta
    meta(charset="utf-8")/
    meta(name="viewport", content="width=device-width, initial-scale=1.0")/
    meta(name="theme-color", content="#d40202")/
    meta(name="color-scheme", content="light")/
    meta(name="author", content="Youssef Ibrahim")/
    meta(name="google", content="notranslate")/
    meta(name="robots", content="none")/
    meta(name="description", content=errorMESSAGE)/
    meta(name="twitter:card", content="summary")/
    meta(property="og:url", content="http://localhost/www/Kawader%20Medical")/
    meta(property="og:site_name", content="خطأ")/
    meta(property="og:title", content=errorCODE)/
    meta(property="og:description", content=errorMESSAGE)/
    //- link
    link(rel="canonical", href="http://localhost/www/Kawader%20Medical/")/
    link(rel="icon", type="image/png", href="../assets/images/error-icon.png")/
    link(rel="stylesheet", type="text/css", href="./css/main.css")/
    //- title
    title #{errorCODE} | #{errorMESSAGE}
    //- script
    script(type="application/javascript", src="./js/main.js", async=true)
    noscript لفتح الموقع (JavaScript) الرجاء فتح الجافا سكريبت
  body
    //- error-page
    .error-page
      h1 #{errorCODE}
      p #{errorMESSAGE}
      button#home(type="button") الرجوع إلى الصفحة الرئيسية