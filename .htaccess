AddDefaultCharset utf-8

# diractions

Options -Indexes

# GZIP

<ifmodule mod_deflate.c>
AddOutputFilterByType DEFLATE text/text text/html text/css text/javascript text/xml text/plain font/ttf font/woff2 image/x-icon image/png image/gif image/svg+xml
</ifmodule>

# index

DirectoryIndex index.php

# errors

ErrorDocument 401 http://localhost/www/Kawader%20Medical/error/401.htm
ErrorDocument 403 http://localhost/www/Kawader%20Medical/error/403.htm
ErrorDocument 404 http://localhost/www/Kawader%20Medical/error/404.htm
ErrorDocument 408 http://localhost/www/Kawader%20Medical/error/408.htm
ErrorDocument 500 http://localhost/www/Kawader%20Medical/error/500.htm
ErrorDocument 502 http://localhost/www/Kawader%20Medical/error/502.htm
ErrorDocument 504 http://localhost/www/Kawader%20Medical/error/504.htm